# ConBOT Environment Variables Template
#
# Copy this file to .env for local development
# For Databricks deployment, use Databricks Secrets instead
#
# cp .env.template .env
# Edit .env with your actual values

# =============================================================================
# Email (SMTP)
# =============================================================================

# SMTP (any provider: Gmail, Outlook, Fastmail, Mailgun, ...)
# Gmail: enable 2-step verification, then create an "App password" at
# https://myaccount.google.com/apppasswords and use that as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587          # 587 = STARTTLS, 465 = implicit TLS
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password

# From address (optional, defaults to SMTP_USERNAME)
# SENDER_EMAIL=you@gmail.com

# Where alerts go (used by `python -m conbot.main`; the CLI takes -r instead)
# RECIPIENT_EMAIL=you@example.com

# =============================================================================
# OpenAI LLM Configuration (Optional)
# =============================================================================

# OpenAI API key for GPT-4o-mini
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# LLM model to use (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Monthly LLM cost limit in USD (default: 10.0)
# LLM_MONTHLY_LIMIT=10.0

# =============================================================================
# Databricks Configuration (Local Testing Only)
# =============================================================================

# Databricks workspace URL
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# Databricks personal access token
# DATABRICKS_TOKEN=dapi...

# =============================================================================
# ConBOT Configuration
# =============================================================================

# Path to conferences.yaml config file
# CONBOT_CONFIG_PATH=config/conferences.yaml

# Delta table base path (Databricks only)
# DELTA_TABLE_PATH=dbfs:/conbot/delta

# SimHash threshold for semantic change detection (default: 5)
# Higher = less sensitive, fewer false positives
# SIMHASH_THRESHOLD=5

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# =============================================================================
# For Local Development
# =============================================================================

# Use local mode (no Databricks/Delta tables)
# Set to 'true' to use in-memory storage for testing
# LOCAL_MODE=false
